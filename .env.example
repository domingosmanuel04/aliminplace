# Trauner — copy to .env
NODE_ENV=development
APP_NAME=Trauner
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=v1
APP_DOMAIN=localhost
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Database
DATABASE_URL=postgresql://trauner:trauner@127.0.0.1:5450/trauner?schema=public

# Redis / queues
REDIS_URL=redis://localhost:6390

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Storage (S3 compatible / MinIO)
S3_ENDPOINT=http://localhost:9020
S3_REGION=us-east-1
S3_BUCKET=trauner
S3_ACCESS_KEY=trauner
S3_SECRET_KEY=traunersecret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9020/trauner

# Payments — sandbox is the default adapter. Never store raw card data.
PAYMENT_GATEWAY=sandbox
PAYMENT_SANDBOX_AUTO_APPROVE=true
# Optional live adapters (leave empty to keep sandbox)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Email — console adapter in development
MAIL_DRIVER=console
MAIL_FROM=Trauner <laura.c@example.net>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# WhatsApp (optional)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# AI — if unset, Trauner uses the local business-intelligence engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Platform
PLATFORM_CURRENCY=AOA
PLATFORM_COUNTRY=AO
DEFAULT_LOCALE=pt-AO

# Super admin seed
SEED_ADMIN_EMAIL=emma.t@example.net
SEED_ADMIN_PASSWORD=Admin@123!

# Rate limit
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Observability
LOG_LEVEL=info
